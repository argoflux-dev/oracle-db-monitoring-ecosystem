groups:
  - name: oracle_exporter_alerts
    rules:
      # ---- Alert 1: DBMS overload due to the inclusion of active sessions ----
      - alert: OracleHighActiveSessions
        expr: oracle_active_user_sessions > 300
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "Critical load on Oracle DB"
          description: {% raw %}"Number of sessions: {{ $value }} duration > 30 seconds."{% endraw %}

      # ---- Alert 2: heartbeat, agent has stopped sending metrics ----
      - alert: OracleAgentDead
        expr: time() - push_time_seconds{job="oracle_exporter"} > 30
        for: 30s
        labels:
          severity: critical
        annotations:
          summary: "The Oracle monitoring agent has disconnected"
          description: "Pushgateway has not received any updates from the script for over 30 seconds."

      # ---- Alert 3: The metrics have disappeared from Pushgateway entirely. ----
      - alert: OraclePushMetricMissing
        expr: absent(push_time_seconds{job="oracle_exporter"})
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Oracle agent metrics have disappeared from Pushgateway"
          description: "The `push_time_seconds` series has been missing for over a minute: either Pushgateway has been restarted, or the agent is not pushing data."
