global:
  scrape_interval: 10s

scrape_configs:
  - job_name: 'pushgateway'
    honor_labels: true  # Сохраняет оригинальные метки от Python-скрипта
    static_configs:
      - targets: ['pushgateway:9091']

rule_files:
  - "alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"

remote_write:
  - url: '${grafana_cloud_url}'
    basic_auth:
      username: '${grafana_cloud_user}'
      password: '${grafana_cloud_token}'