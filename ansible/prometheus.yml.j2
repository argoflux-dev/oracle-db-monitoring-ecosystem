global:
  scrape_interval: 10s

scrape_configs:
  - job_name: 'pushgateway'
    honor_labels: true  # Сохраняет оригинальные метки от Python-скрипта
    static_configs:
      - targets: ['pushgateway:9091']

rule_files:
  - "alert_rules.yml"

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"
